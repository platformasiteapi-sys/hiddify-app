# Normalize line endings on commit (avoid Windows autocrlf noise polluting diffs/merges).
# Files are stored as LF in the repo; Windows checkouts will get CRLF automatically.

* text=auto eol=lf

# Explicit text types
*.dart      text eol=lf
*.yaml      text eol=lf
*.yml       text eol=lf
*.json      text eol=lf
*.md        text eol=lf
*.sh        text eol=lf
*.gradle    text eol=lf
*.properties text eol=lf
*.xml       text eol=lf
*.cc        text eol=lf
*.h         text eol=lf
*.cmake     text eol=lf
*.swift     text eol=lf
*.kt        text eol=lf
*.java      text eol=lf
*.m         text eol=lf

# Windows-native files keep CRLF
*.bat       text eol=crlf
*.cmd       text eol=crlf
*.rc        text eol=crlf
*.ps1       text eol=crlf

# Binary — never touch
*.png       binary
*.jpg       binary
*.jpeg      binary
*.gif       binary
*.ico       binary
*.icns      binary
*.ttf       binary
*.otf       binary
*.woff      binary
*.woff2     binary
*.pdf       binary
*.zip       binary
*.jar       binary
*.keystore  binary
*.jks       binary
*.so        binary
*.dylib     binary
*.dll       binary
*.a         binary
*.lib       binary
*.PNG       binary
